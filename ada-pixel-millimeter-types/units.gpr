project Units is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("naive_check.adb", "measure_width.adb", "tolerance_check.adb", "small_check.adb",
                 "dim_check.adb", "area_check.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;
end Units;
