project Frame_Capture is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("capture_main.adb");

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnata");
   end Compiler;
end Frame_Capture;
