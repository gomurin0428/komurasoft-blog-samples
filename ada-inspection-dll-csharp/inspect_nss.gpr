--  inspect.gpr と同じライブラリを、gnat.adc の pragma Restrictions (No_Secondary_Stack)
--  を付けてビルドする（記事の「二次スタック」の段落を確かめる）。
library project Inspect_Nss is
   for Source_Dirs use ("src");
   for Object_Dir use "obj-nss";
   for Library_Name use "inspect";
   for Library_Dir use "lib-nss";
   for Library_Kind use "dynamic";
   for Library_Interface use ("Inspect_API");
   for Library_Auto_Init use "true";
   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;
end Inspect_Nss;
