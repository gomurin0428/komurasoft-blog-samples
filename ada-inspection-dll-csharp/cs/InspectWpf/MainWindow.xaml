<Window x:Class="InspectWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="検査" Width="720" Height="600">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button x:Name="InspectButton" Content="検査する" Padding="16,4" Click="InspectButton_Click" />
      <TextBlock x:Name="ResultText" Margin="16,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Image x:Name="FrameImage" Stretch="Uniform" />
  </DockPanel>
</Window>
